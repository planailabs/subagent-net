# Copy to .env (next to where you run `personality up`), or pass
# --env-file PATH. Variables already set in the environment win.

# Vesper's mind (or use --llm-url for another OpenAI-compatible endpoint).
DEEPSEEK_API_KEY=

# Web search and scraping through Firecrawl's MCP server. Leave empty to
# run her offline.
FIRECRAWL_API_KEY=
# FIRECRAWL_API_URL=https://firecrawl.example.org   # a self-hosted Firecrawl

# Optional: your own Postgres instead of a private one in vesper-data/pg.
# DATABASE_URL=postgres://localhost/vesper
# SUBJECT_MEMORY_EMBEDDINGS=off   # BM25-only memory recall
